generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String
  createdAt      DateTime @default(now())
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String
  coverImage String?
  published  Boolean  @default(false)
  category   String   @default("STORY")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Interview {
  id          String   @id @default(cuid())
  title       String
  outlet      String
  date        DateTime
  videoUrl    String?
  articleUrl  String?
  description String
  coverImage  String?
  upcoming    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id              String  @id @default("singleton")
  name            String  @default("Sahar Nikzad")
  tagline         String  @default("IB Student · WLOT Scholar · Founder · Dreamer · Builder")
  bio             String  @default("")
  visionStatement String  @default("")
  profileImage    String?
  resumeUrl       String?
}
